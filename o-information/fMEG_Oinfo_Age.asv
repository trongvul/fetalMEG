% O-Information analysis of fMEG with respect to conceptional age
clearvars
close all
rng(329014901)

% Setup paths
baseDir = "\\10.174.1.22\data\FETAL_USER\FAIRY_THEM_ALL_2024_withICA\Consciousness_24_ICA";
allSubjectsDir = dir(baseDir);
%numSubjects = length(allSubjectsDir);
numSubjects = 10;
numChannels = 10;

% Use a cell array to accumulate results
compiledData = {}; 

fprintf('Starting analysis...\n');

for i = 1:numSubjects
    subjName = allSubjectsDir(i).name;
    try
        if contains(subjName, "SSW", 'IgnoreCase', true) && ~contains(subjName, "Spont", 'IgnoreCase', true)
            % Locate and load 10-channel MEG
            clusterPath = fullfile(allSubjectsDir(i).folder, allSubjectsDir(i).name, '3_fMEG', 'initial_cluster.mat');
            
            % Define Paths
            subjPath = fullfile(allSubjectsDir(i).folder, subjName);
            clusterPath = fullfile(subjPath, '3_fMEG', 'initial_cluster.mat');
            sswPath = fullfile(subjPath, '0_info', 'ssw.mat');

            if isfile(clusterPath) && isfile(sswPath)
               % Load MEG data
                dataStruct = load(clusterPath);
                data = dataStruct.initial_cluster;
                
                % Load conceptional age (SSW)
                sswStruct = load(sswPath);
                currentSSW = sswStruct.ssw;
            end
            
            % Calculate O-Information
            assert(size(data,1)==numChannels,'Wrong number of channels')
            SIGMA = cov(zscore(data'));
            omegaVal = soinfo_from_covmat(SIGMA, length(data));
            
            % Store in cell array: {SubjectName, SSW, Omega}
            compiledData{end+1, 1} = subjName; %#ok<AGROW>
            compiledData{end, 2} = currentSSW;
            compiledData{end, 3} = omegaVal;

            fprintf('Processed %s: SSW = %d, Omega = %.2f\n', subjName, currentSSW, omegaVal);        
        end
    catch ME
        fprintf('Error at index %d (%s): %s\n', i, subjName, ME.message);    
    end
end

% Convert to Table at the very end
if ~isempty(compiledData)
    results = cell2table(compiledData, 'VariableNames', {'SubjectID', 'SSW', 'Omega'});
    fprintf('\nAnalysis complete. Found %d valid subjects.\n', height(results));
else
    fprintf('\nNo subjects matched the criteria.\n');
end

if iscell(results.SSW) || isstring(results.SSW)
    sswResults = str2double(results.SSW);
else
    sswResults = results.SSW;
end

% Create the figure
figure('Color', 'w', 'Position', [100, 100, 800, 600]);
hold on;

% Scatter plot of the data
s = scatter(sswResults, results.Omega);

% Add a Trend Line (Linear Fit)
if height(results) > 1
    % Fit: Omega = p1*SSW + p2
    [p, S] = polyfit(sswResults, results.Omega, 1);
    x_range = linspace(min(sswResults), max(sswResults), 100);
    [y_fit, delta] = polyval(p, x_range, S);
    
    plot(x_range, y_fit, 'r-', 'LineWidth', 2, 'DisplayName', 'Linear Trend');
    
    % Add a shaded 95% Confidence Interval
    %fill([x_range, fliplr(x_range)], [y_fit+2*delta, fliplr(y_fit-2*delta)], ...
    %    'r', 'FaceAlpha', 0.1, 'EdgeColor', 'none', 'HandleVisibility', 'off');
    
    % Calculate Correlation for the title
    [r, pval] = corr(sswResults, results.Omega);
    title_str = sprintf('Development of Fetal Brain Information Dynamics\n(r = %.2f, p = %.3f)', r, pval);
else
    title_str = 'Fetal Brain Information Dynamics';
end

% Add reference line for Synergy vs Redundancy
yline(0, '--k', 'LineWidth', 1.5, 'Label', 'Redundancy (+) / Synergy (-)');

% 5. Labeling
xlabel('Conceptional Age (SSW)');
ylabel('O-Information (\Omega) [bits]');
title(title_str);
grid on;
legend('Location', 'northeast');

% 6. Clean up axes
set(gca, 'FontSize', 12, 'TickDir', 'out');